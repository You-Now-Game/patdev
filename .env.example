# Строка подключения к PostgreSQL.
# Локально (docker-compose): postgresql://patina:patina@localhost:5432/patina_studio?schema=public
DATABASE_URL="postgresql://patina:patina@localhost:5432/patina_studio?schema=public"

# Секрет для подписи сессий Auth.js. Сгенерировать: openssl rand -base64 32
AUTH_SECRET="change-me"

# Публичный адрес сайта. На проде — реальный домен, напр. https://patinastudio.ru
NEXTAUTH_URL="http://localhost:3000"

# Стабильный ключ Server Actions между выкладками. Сгенерировать: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
